<? USE CMLStringArgFilter ?>
<? USE date ?>
//#exec(LW_visbox&0&%LBX)
#exec(LW_lockbox&%LBX)
#exec(LW_enb&0&%RMLST)
#font(WF,WF,YF)

#ebox[%L](x:160,y:30,w:100%-340,h:160)
#ebox[%E](x:160,y:24,w:100%-340,h:30)
#pan[%MPN](%L[x:0,y:0,w:100%,h:100%],8)
#ctxt[%TIT](%E[x:0,y:0,w:100%,h:10],{},"Server Support")

#font(WF,YF,WF)

#apan(%L[x:20,y:44,w:80%,h:24],{GW|url&https://discord.gg/ZzUVRjA},15)
#txt[%L_NAME](%L[x:20,y:44,w:100%,h:24],{},"American Conquest Discord")

#apan(%L[x:20,y:110,w:80%,h:24],{GW|url&https://paypal.me/acdevdonate},15)
#txt[%L_NAME](%L[x:20,y:110,w:100%,h:24],{},"Donate")

#sbtn[%B_RGST](%L[x:135,y:100%+5,w:100,h:24],{<? IF backto ?>GW|<? backto ?><? ELSE ?>LW_file&Internet/Cash/cancel.cml<? END ?>},"Close")

