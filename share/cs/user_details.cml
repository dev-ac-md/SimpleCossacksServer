<?~ SET bottom_height = 32 ~?>
<?~ USE POSIX ~?>
<?~ USE CMLStringArgFilter ~?>
<?~ USE CMDFilter ~?>
#resize(LW_cfile&<#WinH#>&height.dat|LW_show&<\52ESIZE>
#exec(GW\7Copen\26resize\26height=<#WinH#>\29
<\52ESIZE>)

#def_panel(15,Internet/pix/i_bor%d,48,49,50,51,52,53,55,54,67,45)
#font(YF,WF,WF)
#box[%BOTTOM](x:0,w:100%,y:100%-<? bottom_height ?>,h:<? bottom_height ?>)
#pan(%BOTTOM[x:0-1,w:100%+2,y:0-1,h:100%+2],1)
#btn(%BOTTOM[x:5,y:4,w:80,h:28],{<? IF backto ?>GW|<? backto ?><? ELSE ?>GW|open&startup<? END ?>},"Back")

#font(YF,YF,YF)
#rtxt(%BOTTOM[x1:100%-14,x:300,y:7,h:24],{},"User Details")

#box[%LBX](x:0,y:0,w:100%,h:100%-<? bottom_height ?>)
<?IF error ?>
    #txt(%LBX[x:10,y:10,w:200,h:30],{}, <? error ?>)
<? ELSE ?>
    #font(YF,WF,WF)
    #txt(%LBX[x:10,y:10,w:200,h:30],{},"Nickname:")
    #txt(%LBX[x:220,y:10,w:150,h:30],{},"<? player.nickName ?>")

    #txt(%LBX[x:10,y:40,w:200,h:30],{},"Total play time:")
    #txt(%LBX[x:220,y:40,w:150,h:30],{},"<? player.totalPlayTime ?>")
<? END ?>

<NGDLG>
<NGDLG>

<RESIZE>
<? IF window_size == 'large' ~?>
#large
<? END ?>
<RESIZE>

#save(users_table_dgl.dcml,PLAYERS)

#block(cancel.cml,CAN)<NGDLG>
<NGDLG>
#end(CAN)
